# Copy this file to .env (already gitignored — never commit real secrets) and fill in
# real values. Docker Compose automatically loads a .env file in this directory.

# Optional: enables real LLM categorization via Groq. Get one at
# https://console.groq.com/keys (free tier, no credit card).
# If unset, the app still works — CategorizationService falls back to rule-based matching.
GROQ_API_KEY=
